{
	"name": "@naivezip/pi-swarm",
	"version": "0.1.0",
	"description": "Native-style multi-agent swarm orchestration package for Pi",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"files": [
		"extensions",
		"skills",
		"src",
		"README.md",
		"README.zh.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/naivezip/pi-swarm.git"
	},
	"homepage": "https://github.com/naivezip/pi-swarm#readme",
	"bugs": {
		"url": "https://github.com/naivezip/pi-swarm/issues"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		],
		"skills": [
			"./skills"
		],
		"image": "https://raw.githubusercontent.com/naivezip/pi-swarm/main/assets/demo-overview.png",
		"video": "https://raw.githubusercontent.com/naivezip/pi-swarm/main/assets/demo.mp4"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"typecheck": "node ../pi/node_modules/typescript/bin/tsc --noEmit",
		"test": "node ../pi/node_modules/vitest/vitest.mjs run",
		"check": "biome check .",
		"format": "biome format --write .",
		"prepare": "lefthook install"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"lefthook": "^2.2.3"
	}
}
